{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rivu:audio-processing:event:3",
  "title": "Version 3 bounded framed JSON control and raw PCM outputs",
  "type": "object",
  "required": ["version", "task_id", "type"],
  "unevaluatedProperties": false,
  "properties": {
    "version": {"const": 3},
    "task_id": {"type": "string", "maxLength": 128},
    "type": {"enum": ["progress", "complete", "error"]}
  },
  "oneOf": [
    {
      "required": ["stage", "completed", "total"],
      "properties": {
        "type": {"const": "progress"},
        "stage": {"enum": ["inspect", "load", "inference", "copy"]},
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    {
      "required": ["outputs", "sample_rate", "channels", "frames", "model"],
      "properties": {
        "type": {"const": "complete"},
        "outputs": {
          "type": "object",
          "description": "Availability of exact source-aligned raw PCM streams. Complete is valid only after every declared frame has arrived; no retained output paths exist.",
          "additionalProperties": false,
          "properties": {
            "speech": {"const": true},
            "vocals": {"const": true},
            "accompaniment": {"const": true}
          },
          "oneOf": [{"required": ["speech"], "maxProperties": 1}, {"required": ["vocals", "accompaniment"], "maxProperties": 2}]
        },
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "channels": {"enum": [1, 2]},
        "frames": {"type": "integer", "minimum": 1, "maximum": 2764800000},
        "model": {
          "type": "object", "required": ["id", "sha256"], "additionalProperties": false,
          "properties": {
            "id": {"enum": ["MossFormer2_SE_48K", "nsnet2", "DeepFilterNet3", "melband_roformer_kim", "htdemucs"]},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Canonical prepared manifest SHA256; explicit evaluation export may retain detailed provenance."}
          }
        }
      }
    },
    {
      "required": ["code", "message"],
      "properties": {
        "type": {"const": "error"},
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "description": "Process exits nonzero. No result is committed. Cancellation terminates and reaps the subprocess, including after early stdout EOF. No implicit files require cleanup."
    }
  ]
}
