{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rivu:audio-processing:event:2",
  "title": "Version 2 bounded completion; full evidence remains in task-owned result.json",
  "type": "object",
  "required": ["version", "task_id", "type"],
  "unevaluatedProperties": false,
  "properties": {
    "version": {"const": 2},
    "task_id": {"type": "string", "maxLength": 128},
    "type": {"enum": ["progress", "complete", "error"]}
  },
  "oneOf": [
    {
      "required": ["stage", "completed", "total"],
      "properties": {
        "type": {"const": "progress"},
        "stage": {"enum": ["inspect", "load", "inference"]},
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    {
      "required": ["outputs", "sample_rate", "channels", "frames", "model"],
      "properties": {
        "type": {"const": "complete"},
        "outputs": {
          "type": "object",
          "description": "Fixed WAV basenames relative to the request's output_dir, published only after successful complete and result.json write. Source format and unclipped float samples are preserved.",
          "additionalProperties": false,
          "properties": {
            "speech": {"const": "speech.wav"},
            "vocals": {"const": "vocals.wav"},
            "accompaniment": {"const": "accompaniment.wav"}
          },
          "oneOf": [{"required": ["speech"], "maxProperties": 1}, {"required": ["vocals", "accompaniment"], "maxProperties": 2}]
        },
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "channels": {"enum": [1, 2]},
        "frames": {"type": "integer", "minimum": 1, "maximum": 2764800000},
        "model": {
          "type": "object", "required": ["id", "sha256"], "additionalProperties": false,
          "properties": {
            "id": {"enum": ["MossFormer2_SE_48K", "nsnet2", "DeepFilterNet3", "melband_roformer_kim", "htdemucs"]},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Canonical manifest SHA256; full artifact/provenance evidence is in result.json."}
          }
        }
      }
    },
    {
      "required": ["code", "message"],
      "properties": {
        "type": {"const": "error"},
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "description": "Process exits nonzero. No result is committed. Cancellation is terminating/reaping the subprocess, not a stdin protocol; caller owns scratch cleanup. A partial directory after signal termination is not a successful output."
    }
  ]
}
